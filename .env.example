# Do not put exchange API credentials in this file. The app stores them in the
# OS credential vault by default. For headless/packaged deployments, set this
# to a URL-safe base64 32-byte key and use CREDENTIAL_STORAGE=encrypted_db.
CREDENTIAL_STORAGE=auto
CREDENTIAL_MASTER_KEY=
DEEPCOIN_API_BASE_URL=https://api.deepcoin.com
